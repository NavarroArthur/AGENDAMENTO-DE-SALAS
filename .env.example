# Copie este arquivo para .env e ajuste os valores.
# O .env NÃO deve ir para o Git (já está no .gitignore).

SECRET_KEY=troque-por-uma-chave-secreta-bem-longa
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Banco de dados ---------------------------------------------------------
# Sem DB_NAME, o projeto usa SQLite automaticamente (ótimo para desenvolver).
# Para usar PostgreSQL, descomente e preencha as variáveis abaixo:
# DB_NAME=reservasalas_db
# DB_USER=postgres
# DB_PASSWORD=sua-senha
# DB_HOST=localhost
# DB_PORT=5432
